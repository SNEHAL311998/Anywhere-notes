{
  "name": "snehal-anywhere-notes",
  "description": "Create and manage global notes from any workspace using simple keyboard shortcuts.",
  "displayName": "Anywhere Notes",
  "publisher": "Snehal",
  "version": "1.0.4",
  "icon": "assets/global-notes.png",
  "preview": false,
  "galleryBanner.color": {
    "color": "#af4dc8",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SNEHAL311998/Global-notes.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Azure",
    "Chat",
    "Data Science",
    "Debuggers",
    "Extension Packs",
    "Education",
    "Formatters",
    "Keymaps",
    "Language Packs",
    "Linters",
    "Machine Learning",
    "Notebooks",
    "Programming Languages",
    "SCM Providers",
    "Snippets",
    "Testing",
    "Themes",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "notes",
    "memo",
    "global",
    "productivity",
    "markdown"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anywhere-notes.addNote",
        "title": "Notes: Add New Note"
      },
      {
        "command": "anywhere-notes.setFolder",
        "title": "Notes: Set Storage Folder"
      },
      {
        "command": "anywhere-notes.createFolder",
        "title": "Notes: Create Folder"
      },
      {
        "command": "anywhere-notes.showFolder",
        "title": "Notes: Show Path"
      }
    ],
    "keybindings": [
      {
        "command": "anywhere-notes.addNote",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "anywhere-notes.createFolder",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
